// SHA-1 (FIPS 180-1) - freestanding one-shot digest.
package hash

fn sha1Block(h: *u32, block: *u8) {
    var w: [80]u32
    var i: u64 = 0
    while i < 16 {
        w[i] = loadBE32(block + i * 4)
        i = i + 1
    }
    while i < 80 {
        w[i] = rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1)
        i = i + 1
    }
    var a: u32 = *h
    var b: u32 = *(h + 1)
    var c: u32 = *(h + 2)
    var d: u32 = *(h + 3)
    var e: u32 = *(h + 4)
    i = 0
    while i < 80 {
        var f: u32
        var k: u32
        if i < 20 {
            f = (b & c) | (not32(b) & d)
            k = 0x5a827999
        } else {
            if i < 40 {
                f = b ^ c ^ d
                k = 0x6ed9eba1
            } else {
                if i < 60 {
                    f = (b & c) | (b & d) | (c & d)
                    k = 0x8f1bbcdc
                } else {
                    f = b ^ c ^ d
                    k = 0xca62c1d6
                }
            }
        }
        var temp: u32 = add32x5(rotl32(a, 5), f, e, k, w[i])
        e = d
        d = c
        c = rotl32(b, 30)
        b = a
        a = temp
        i = i + 1
    }
    *h = add32(*h, a)
    *(h + 1) = add32(*(h + 1), b)
    *(h + 2) = add32(*(h + 2), c)
    *(h + 3) = add32(*(h + 3), d)
    *(h + 4) = add32(*(h + 4), e)
}

// SHA1 writes a 20-byte digest of data[0:n] into out.
fn SHA1(data: *u8, n: u64, out: *u8) -> *u8 {
    if out == null {
        return "hash: null out"
    }
    if data == null && n > 0 {
        return "hash: null data"
    }
    var h: [5]u32
    h[0] = 0x67452301
    h[1] = 0xefcdab89
    h[2] = 0x98badcfe
    h[3] = 0x10325476
    h[4] = 0xc3d2e1f0

    var off: u64 = 0
    while off + 64 <= n {
        sha1Block(&h[0], data + off)
        off = off + 64
    }

    var block: [64]u8
    var rem: u64 = n - off
    var j: u64 = 0
    while j < rem {
        block[j] = *(data + off + j)
        j = j + 1
    }
    block[rem] = 0x80
    j = rem + 1
    while j < 64 {
        block[j] = 0
        j = j + 1
    }

    var bitLen: u64 = n * 8
    if rem < 56 {
        storeBE64(&block[56], bitLen)
        sha1Block(&h[0], &block[0])
    } else {
        sha1Block(&h[0], &block[0])
        j = 0
        while j < 64 {
            block[j] = 0
            j = j + 1
        }
        storeBE64(&block[56], bitLen)
        sha1Block(&h[0], &block[0])
    }

    storeBE32(out, h[0])
    storeBE32(out + 4, h[1])
    storeBE32(out + 8, h[2])
    storeBE32(out + 12, h[3])
    storeBE32(out + 16, h[4])
    return 0
}
