// Package process - dual-OS process spawn with stdio pipes, cwd, env, shell helpers.
//
// Requires runtime.Init(stack_hint). Fallible APIs use *u8 errors (0 = ok).
//
// Linux: raw syscalls (pipe/fork/execve/wait4/…). Windows: kernel32 CreateProcessA + pipes.
//
// Typical use:
//   var c: process.Cmd
//   process.Command(&c, "/bin/echo")
//   // set c.argv / c.dir / c.env / stdio modes
//   code, err := process.Run(&c)
//
//   out, err := process.ShellOutput("uname -a")
//   defer free(out)
package process

import "std/runtime"
import lresolve "std/linux/resolve"
import wresolve "std/windows/resolve"

type PVOID = *void
type Handle = u64

const INVALID: u64 = 0xFFFFFFFFFFFFFFFF

// Stdio modes for Cmd.stdin_mode / stdout_mode / stderr_mode.
const STD_INHERIT: u64 = 0
const STD_PIPE: u64 = 1
const STD_NULL: u64 = 2

// Soft cap for captured output (64 MiB).
const MAX_OUTPUT: u64 = 67108864

// Linux syscalls (x86_64)
const SYS_READ: u64 = 0
const SYS_WRITE: u64 = 1
const SYS_CLOSE: u64 = 3
const SYS_PIPE: u64 = 22
const SYS_DUP2: u64 = 33
const SYS_FORK: u64 = 57
const SYS_EXECVE: u64 = 59
const SYS_EXIT: u64 = 60
const SYS_WAIT4: u64 = 61
const SYS_KILL: u64 = 62
const SYS_CHDIR: u64 = 80
const SYS_OPEN: u64 = 2
const O_RDWR: u64 = 2
const O_RDONLY: u64 = 0
const O_WRONLY: u64 = 1
// /dev/null path built at use sites (avoid const *u8 globals; see string init).

// Windows constants
const W_STARTF_USESTDHANDLES: u32 = 0x100
const W_STARTF_USESHOWWINDOW: u32 = 0x1
const W_SW_HIDE: u16 = 0
const W_CREATE_NO_WINDOW: u32 = 0x08000000
const W_HANDLE_FLAG_INHERIT: u32 = 1
const W_INFINITE: u32 = 0xFFFFFFFF
const W_WAIT_OBJECT_0: u32 = 0
const W_GENERIC_READ: u32 = 0x80000000
const W_GENERIC_WRITE: u32 = 0x40000000
const W_FILE_SHARE_READ: u32 = 1
const W_FILE_SHARE_WRITE: u32 = 2
const W_OPEN_EXISTING: u32 = 3
const W_CREATE_ALWAYS: u32 = 2
const W_FILE_ATTRIBUTE_NORMAL: u32 = 0x80

type FnCreatePipe = fn(PVOID, PVOID, PVOID, u32) -> u32
type FnSetHandleInformation = fn(Handle, u32, u32) -> u32
type FnCreateProcessA = fn(*u8, *u8, PVOID, PVOID, u32, u32, PVOID, *u8, PVOID, PVOID) -> u32
type FnWaitForSingleObject = fn(Handle, u32) -> u32
type FnGetExitCodeProcess = fn(Handle, *u32) -> u32
type FnTerminateProcess = fn(Handle, u32) -> u32
type FnCloseHandle = fn(Handle) -> u32
type FnReadFile = fn(Handle, PVOID, u32, *u32, PVOID) -> u32
type FnWriteFile = fn(Handle, PVOID, u32, *u32, PVOID) -> u32
type FnCreateFileA = fn(*u8, u32, u32, PVOID, u32, u32, Handle) -> Handle

// Cmd configures and tracks a child process.
// Zero with Command() / Zero() before use.
struct Cmd {
    // --- config (set before Start) ---
    program: *u8       // executable path (required unless Shell helpers)
    argv: **u8      // null-terminated argv; null → [path, null]
    dir: *u8        // working directory; null = inherit
    env: **u8       // null-terminated envp (KEY=VAL); null = inherit
    stdin_mode: u64
    stdout_mode: u64
    stderr_mode: u64
    // Windows: full command line (if set, used instead of building from argv)
    cmdline: *u8
    // hide console window on Windows (default true for shell helpers)
    hide_window: u64

    // --- state (filled by Start / Wait) ---
    pid: u64
    exit_code: i32
    started: u64
    waited: u64
    // parent-side pipe ends (close with Release)
    stdin_w: Handle
    stdout_r: Handle
    stderr_r: Handle
    // Windows process/thread handles
    h_process: Handle
    h_thread: Handle
    // internal child-side pipe ends (closed after Start)
    _in_r: Handle
    _out_w: Handle
    _err_w: Handle
    // embedded argv storage for shell helpers (must be contiguous)
    _a0: *u8
    _a1: *u8
    _a2: *u8
    _a3: *u8
    _a4: *u8
}

struct State {
    ready: u64
    environ: **u8
    // Windows API pointers
    create_pipe: PVOID
    set_handle_info: PVOID
    create_process: PVOID
    wait_object: PVOID
    get_exit: PVOID
    terminate: PVOID
    close_handle: PVOID
    read_file: PVOID
    write_file: PVOID
    create_file: PVOID
}

var g: State

// Zero clears a Cmd to defaults (inherit stdio, visible window flag 0).
fn Zero(c: *Cmd) {
    __memset(cast[*void](c), 0, sizeof(Cmd))
    c.stdin_w = INVALID
    c.stdout_r = INVALID
    c.stderr_r = INVALID
    c.h_process = INVALID
    c.h_thread = INVALID
    c._in_r = INVALID
    c._out_w = INVALID
    c._err_w = INVALID
}

// Command initializes c to run path with default inherit stdio.
fn Command(c: *Cmd, program: *u8) {
    Zero(c)
    c.program = program
}

// SetArgv sets null-terminated argv (argv[0] is usually the program name).
fn SetArgv(c: *Cmd, argv: **u8) {
    c.argv = argv
}

// SetDir sets the child working directory (null = inherit).
fn SetDir(c: *Cmd, dir: *u8) {
    c.dir = dir
}

// SetEnv sets environment as null-terminated list of "KEY=VAL" strings (null = inherit).
fn SetEnv(c: *Cmd, env: **u8) {
    c.env = env
}

// SetStdin / SetStdout / SetStderr set STD_INHERIT, STD_PIPE, or STD_NULL.
fn SetStdin(c: *Cmd, mode: u64) {
    c.stdin_mode = mode
}

fn SetStdout(c: *Cmd, mode: u64) {
    c.stdout_mode = mode
}

fn SetStderr(c: *Cmd, mode: u64) {
    c.stderr_mode = mode
}

// PipeAll sets stdin/stdout/stderr to STD_PIPE.
fn PipeAll(c: *Cmd) {
    c.stdin_mode = STD_PIPE
    c.stdout_mode = STD_PIPE
    c.stderr_mode = STD_PIPE
}

fn ensure() -> *u8 {
    if g.ready != 0 {
        return 0
    }
    if !runtime.Ready() {
        return "process: runtime not ready"
    }
    if runtime.IsLinux() {
        return ensure_linux()
    }
    if runtime.IsWindows() {
        return ensure_windows()
    }
    return "process: unknown os"
}

fn ensure_linux() -> *u8 {
    var hint: PVOID = runtime.StackHint()
    var libc: PVOID = lresolve.Module(__hash("libc.so.6"), hint)
    if libc == null {
        libc = lresolve.Module(__hash("libc.so"), hint)
    }
    if libc == null {
        return "process: resolve failed"
    }
    var environ_sym: PVOID = lresolve.Symbol(libc, __hash("environ"))
    if environ_sym != null {
        g.environ = cast[**u8](__load64(environ_sym))
    }
    g.ready = 1
    return 0
}

fn ensure_windows() -> *u8 {
    var k32: PVOID = wresolve.Module(__hash("KERNEL32.DLL"))
    if k32 == null {
        return "process: resolve failed"
    }
    g.create_pipe = wresolve.Symbol(k32, __hash("CreatePipe"))
    g.set_handle_info = wresolve.Symbol(k32, __hash("SetHandleInformation"))
    g.create_process = wresolve.Symbol(k32, __hash("CreateProcessA"))
    g.wait_object = wresolve.Symbol(k32, __hash("WaitForSingleObject"))
    g.get_exit = wresolve.Symbol(k32, __hash("GetExitCodeProcess"))
    g.terminate = wresolve.Symbol(k32, __hash("TerminateProcess"))
    g.close_handle = wresolve.Symbol(k32, __hash("CloseHandle"))
    g.read_file = wresolve.Symbol(k32, __hash("ReadFile"))
    g.write_file = wresolve.Symbol(k32, __hash("WriteFile"))
    g.create_file = wresolve.Symbol(k32, __hash("CreateFileA"))
    if g.create_pipe == null {
        return "process: resolve failed"
    }
    if g.create_process == null {
        return "process: resolve failed"
    }
    if g.wait_object == null {
        return "process: resolve failed"
    }
    if g.get_exit == null {
        return "process: resolve failed"
    }
    if g.close_handle == null {
        return "process: resolve failed"
    }
    if g.read_file == null {
        return "process: resolve failed"
    }
    if g.write_file == null {
        return "process: resolve failed"
    }
    g.ready = 1
    return 0
}

// ---------- low-level I/O on handles ----------

fn write_handle(h: Handle, buf: *u8, n: u64) -> (u64, *u8) {
    if h == INVALID {
        return 0, "process: bad handle"
    }
    if n == 0 {
        return 0, 0
    }
    if runtime.IsLinux() {
        var rc: i64 = cast[i64](__syscall(SYS_WRITE, h, cast[u64](buf), n))
        if rc < 0 {
            return 0, "process: write failed"
        }
        return cast[u64](rc), 0
    }
    var got: u32 = 0
    var f: FnWriteFile = cast[FnWriteFile](g.write_file)
    if f(h, cast[PVOID](buf), cast[u32](n), &got, null) == 0 {
        return 0, "process: write failed"
    }
    return cast[u64](got), 0
}

fn read_handle(h: Handle, buf: *u8, n: u64) -> (u64, *u8) {
    if h == INVALID {
        return 0, "process: bad handle"
    }
    if n == 0 {
        return 0, 0
    }
    if runtime.IsLinux() {
        var rc: i64 = cast[i64](__syscall(SYS_READ, h, cast[u64](buf), n))
        if rc < 0 {
            return 0, "process: read failed"
        }
        return cast[u64](rc), 0
    }
    var got: u32 = 0
    var f: FnReadFile = cast[FnReadFile](g.read_file)
    if f(h, cast[PVOID](buf), cast[u32](n), &got, null) == 0 {
        return 0, "process: read failed"
    }
    return cast[u64](got), 0
}

fn close_handle(h: Handle) {
    if h == INVALID {
        return
    }
    if runtime.IsLinux() {
        __syscall(SYS_CLOSE, h)
        return
    }
    if g.close_handle != null {
        var f: FnCloseHandle = cast[FnCloseHandle](g.close_handle)
        f(h)
    }
}

// WriteStdin writes to the child's stdin pipe (parent side).
fn WriteStdin(c: *Cmd, buf: *u8, n: u64) -> (u64, *u8) {
    return write_handle(c.stdin_w, buf, n)
}

// ReadStdout reads from the child's stdout pipe.
fn ReadStdout(c: *Cmd, buf: *u8, n: u64) -> (u64, *u8) {
    return read_handle(c.stdout_r, buf, n)
}

// ReadStderr reads from the child's stderr pipe.
fn ReadStderr(c: *Cmd, buf: *u8, n: u64) -> (u64, *u8) {
    return read_handle(c.stderr_r, buf, n)
}

// CloseStdin closes the parent write end of stdin (signals EOF to child).
fn CloseStdin(c: *Cmd) {
    close_handle(c.stdin_w)
    c.stdin_w = INVALID
}

// ---------- pipe helpers ----------

fn make_pipe_linux(r: *Handle, w: *Handle) -> *u8 {
    var pfd: [8]u8
    var i: u64 = 0
    while i < 8 {
        pfd[i] = 0
        i = i + 1
    }
    if cast[i64](__syscall(SYS_PIPE, cast[u64](&pfd[0]))) != 0 {
        return "process: pipe failed"
    }
    *r = cast[Handle](__load32(cast[*void](&pfd[0])))
    *w = cast[Handle](__load32(cast[*void](&pfd[0] + 4)))
    return 0
}

// SECURITY_ATTRIBUTES: nLength@0, lpSecurityDescriptor@8, bInheritHandle@16 → size 24
fn make_pipe_windows(r: *Handle, w: *Handle) -> *u8 {
    var sa: [24]u8
    var i: u64 = 0
    while i < 24 {
        sa[i] = 0
        i = i + 1
    }
    __store32(cast[*void](&sa[0]), 24)
    __store32(cast[*void](&sa[0] + 16), 1) // bInheritHandle = TRUE
    var rh: Handle = 0
    var wh: Handle = 0
    var f: FnCreatePipe = cast[FnCreatePipe](g.create_pipe)
    if f(cast[PVOID](&rh), cast[PVOID](&wh), cast[PVOID](&sa[0]), 0) == 0 {
        return "process: pipe failed"
    }
    *r = rh
    *w = wh
    return 0
}

fn make_pipe(r: *Handle, w: *Handle) -> *u8 {
    if runtime.IsLinux() {
        return make_pipe_linux(r, w)
    }
    return make_pipe_windows(r, w)
}

fn noinherit_windows(h: Handle) {
    if g.set_handle_info == null {
        return
    }
    if h == INVALID {
        return
    }
    var f: FnSetHandleInformation = cast[FnSetHandleInformation](g.set_handle_info)
    f(h, W_HANDLE_FLAG_INHERIT, 0)
}

// ---------- Start / Wait / Kill / Release ----------

// Start launches the process. Does not wait.
fn Start(c: *Cmd) -> *u8 {
    var err: *u8 = ensure()
    if err != 0 {
        return err
    }
    if c.started != 0 {
        return "process: already started"
    }
    if c.program == null {
        if c.cmdline == null {
            return "process: no path"
        }
    }
    if runtime.IsLinux() {
        return start_linux(c)
    }
    if runtime.IsWindows() {
        return start_windows(c)
    }
    return "process: unknown os"
}

// touch_cstr forces string decryption before fork (PIC encrypted rdata).
fn touch_cstr(s: *u8) {
    if s != null {
        __strlen(s)
    }
}

fn touch_cmd_strings(c: *Cmd) {
    touch_cstr(c.program)
    touch_cstr(c.dir)
    touch_cstr(c.cmdline)
    if c.argv != null {
        var p: **u8 = c.argv
        while *p != null {
            touch_cstr(*p)
            p = cast[**u8](cast[u64](p) + 8)
        }
    }
    if c.env != null {
        var e: **u8 = c.env
        while *e != null {
            touch_cstr(*e)
            e = cast[**u8](cast[u64](e) + 8)
        }
    }
}

fn start_linux(c: *Cmd) -> *u8 {
    // Decrypt all path/argv/env strings in the parent before fork+CoW.
    touch_cmd_strings(c)
    var err: *u8 = 0
    // setup pipes
    if c.stdin_mode == STD_PIPE {
        err = make_pipe(&c._in_r, &c.stdin_w)
        if err != 0 {
            return err
        }
    }
    if c.stdout_mode == STD_PIPE {
        err = make_pipe(&c.stdout_r, &c._out_w)
        if err != 0 {
            Release(c)
            return err
        }
    }
    if c.stderr_mode == STD_PIPE {
        err = make_pipe(&c.stderr_r, &c._err_w)
        if err != 0 {
            Release(c)
            return err
        }
    }

    var pid: i64 = cast[i64](__syscall(SYS_FORK))
    if pid < 0 {
        Release(c)
        return "process: fork failed"
    }
    if pid == 0 {
        // --- child ---
        if c.dir != null {
            if cast[i64](__syscall(SYS_CHDIR, cast[u64](c.dir))) != 0 {
                __syscall(SYS_EXIT, 127)
            }
        }
        // stdin
        if c.stdin_mode == STD_PIPE {
            __syscall(SYS_DUP2, c._in_r, 0)
        } else {
            if c.stdin_mode == STD_NULL {
                var dn: *u8 = "/dev/null"
                var nfd: i64 = cast[i64](__syscall(SYS_OPEN, cast[u64](dn), O_RDONLY, 0))
                if nfd >= 0 {
                    __syscall(SYS_DUP2, cast[u64](nfd), 0)
                    __syscall(SYS_CLOSE, cast[u64](nfd))
                }
            }
        }
        // stdout
        if c.stdout_mode == STD_PIPE {
            __syscall(SYS_DUP2, c._out_w, 1)
        } else {
            if c.stdout_mode == STD_NULL {
                var dn2: *u8 = "/dev/null"
                var nfd2: i64 = cast[i64](__syscall(SYS_OPEN, cast[u64](dn2), O_WRONLY, 0))
                if nfd2 >= 0 {
                    __syscall(SYS_DUP2, cast[u64](nfd2), 1)
                    __syscall(SYS_CLOSE, cast[u64](nfd2))
                }
            }
        }
        // stderr
        if c.stderr_mode == STD_PIPE {
            __syscall(SYS_DUP2, c._err_w, 2)
        } else {
            if c.stderr_mode == STD_NULL {
                var dn3: *u8 = "/dev/null"
                var nfd3: i64 = cast[i64](__syscall(SYS_OPEN, cast[u64](dn3), O_WRONLY, 0))
                if nfd3 >= 0 {
                    __syscall(SYS_DUP2, cast[u64](nfd3), 2)
                    __syscall(SYS_CLOSE, cast[u64](nfd3))
                }
            }
        }
        // close all pipe fds in child (already dup2'd)
        if c._in_r != INVALID {
            __syscall(SYS_CLOSE, c._in_r)
        }
        if c.stdin_w != INVALID {
            __syscall(SYS_CLOSE, c.stdin_w)
        }
        if c.stdout_r != INVALID {
            __syscall(SYS_CLOSE, c.stdout_r)
        }
        if c._out_w != INVALID {
            __syscall(SYS_CLOSE, c._out_w)
        }
        if c.stderr_r != INVALID {
            __syscall(SYS_CLOSE, c.stderr_r)
        }
        if c._err_w != INVALID {
            __syscall(SYS_CLOSE, c._err_w)
        }

        // argv
        var argv0: [2]*u8
        var argv: **u8 = c.argv
        if argv == null {
            argv0[0] = c.program
            argv0[1] = null
            argv = cast[**u8](&argv0[0])
        }
        // envp
        var envp: **u8 = c.env
        if envp == null {
            envp = g.environ
        }
        if envp == null {
            var empty: [1]*u8
            empty[0] = null
            envp = cast[**u8](&empty[0])
        }
        __syscall(SYS_EXECVE, cast[u64](c.program), cast[u64](argv), cast[u64](envp))
        __syscall(SYS_EXIT, 127)
    }

    // --- parent ---
    c.pid = cast[u64](pid)
    c.started = 1
    // close child ends
    if c._in_r != INVALID {
        close_handle(c._in_r)
        c._in_r = INVALID
    }
    if c._out_w != INVALID {
        close_handle(c._out_w)
        c._out_w = INVALID
    }
    if c._err_w != INVALID {
        close_handle(c._err_w)
        c._err_w = INVALID
    }
    return 0
}

// STARTUPINFOA size 104; PROCESS_INFORMATION size 24 on x64
fn start_windows(c: *Cmd) -> *u8 {
    touch_cmd_strings(c)
    var err: *u8 = 0
    if c.stdin_mode == STD_PIPE {
        err = make_pipe(&c._in_r, &c.stdin_w)
        if err != 0 {
            return err
        }
        noinherit_windows(c.stdin_w)
    }
    if c.stdout_mode == STD_PIPE {
        err = make_pipe(&c.stdout_r, &c._out_w)
        if err != 0 {
            Release(c)
            return err
        }
        noinherit_windows(c.stdout_r)
    }
    if c.stderr_mode == STD_PIPE {
        err = make_pipe(&c.stderr_r, &c._err_w)
        if err != 0 {
            Release(c)
            return err
        }
        noinherit_windows(c.stderr_r)
    }

    // STARTUPINFOA (104 bytes)
    var si: [104]u8
    var i: u64 = 0
    while i < 104 {
        si[i] = 0
        i = i + 1
    }
    __store32(cast[*void](&si[0]), 104) // cb
    var flags: u32 = 0
    if c.stdin_mode == STD_PIPE {
        flags = flags + W_STARTF_USESTDHANDLES
        __store64(cast[*void](&si[0] + 80), c._in_r) // hStdInput @ 0x50
    }
    if c.stdout_mode == STD_PIPE {
        flags = flags + W_STARTF_USESTDHANDLES
        __store64(cast[*void](&si[0] + 88), c._out_w)
    }
    if c.stderr_mode == STD_PIPE {
        flags = flags + W_STARTF_USESTDHANDLES
        __store64(cast[*void](&si[0] + 96), c._err_w)
    }
    // If only some pipes, fill inherit for others from GetStdHandle? Skip - require consistent.
    if c.hide_window != 0 {
        flags = flags + W_STARTF_USESHOWWINDOW
        __store16(cast[*void](&si[0] + 64), cast[u64](W_SW_HIDE))
    }
    __store32(cast[*void](&si[0] + 60), cast[u64](flags)) // dwFlags @ 0x3C

    // PROCESS_INFORMATION (24 bytes)
    var pi: [24]u8
    i = 0
    while i < 24 {
        pi[i] = 0
        i = i + 1
    }

    // Command line: mutable buffer required by CreateProcessA
    var cl: *u8 = c.cmdline
    var cl_owned: *u8 = null
    if cl == null {
        cl_owned, err = build_cmdline(c)
        if err != 0 {
            Release(c)
            return err
        }
        cl = cl_owned
    }

    // Environment block (optional)
    var env_block: PVOID = null
    var env_owned: *u8 = null
    if c.env != null {
        env_owned, err = build_env_block(c.env)
        if err != 0 {
            if cl_owned != null {
                runtime.Free(cast[*void](cl_owned))
            }
            Release(c)
            return err
        }
        env_block = cast[PVOID](env_owned)
    }

    var app: *u8 = c.program
    var creation: u32 = 0
    if c.hide_window != 0 {
        creation = W_CREATE_NO_WINDOW
    }

    var f: FnCreateProcessA = cast[FnCreateProcessA](g.create_process)
    var ok: u32 = f(app, cl, null, null, 1, creation, env_block, c.dir, cast[PVOID](&si[0]), cast[PVOID](&pi[0]))
    if cl_owned != null {
        runtime.Free(cast[*void](cl_owned))
    }
    if env_owned != null {
        runtime.Free(cast[*void](env_owned))
    }
    if ok == 0 {
        Release(c)
        return "process: create failed"
    }

    c.h_process = __load64(cast[*void](&pi[0]))
    c.h_thread = __load64(cast[*void](&pi[0] + 8))
    c.pid = cast[u64](__load32(cast[*void](&pi[0] + 16)))
    c.started = 1

    // close child pipe ends in parent
    if c._in_r != INVALID {
        close_handle(c._in_r)
        c._in_r = INVALID
    }
    if c._out_w != INVALID {
        close_handle(c._out_w)
        c._out_w = INVALID
    }
    if c._err_w != INVALID {
        close_handle(c._err_w)
        c._err_w = INVALID
    }
    return 0
}

// build_cmdline joins argv into a Windows command line (allocates; caller frees).
fn build_cmdline(c: *Cmd) -> (*u8, *u8) {
    // rough size
    var n: u64 = 0
    if c.argv != null {
        var p: **u8 = c.argv
        while *p != null {
            n = n + __strlen(*p) + 3
            p = cast[**u8](cast[u64](p) + 8)
        }
    } else {
        if c.program != null {
            n = __strlen(c.program) + 3
        }
    }
    if n == 0 {
        n = 1
    }
    var raw: *void
    var err: *u8
    raw, err = runtime.Alloc(n + 8)
    if err != 0 {
        return null, err
    }
    var out: *u8 = cast[*u8](raw)
    var di: u64 = 0
    if c.argv != null {
        var first: u64 = 1
        var p2: **u8 = c.argv
        while *p2 != null {
            if first == 0 {
                *(out + di) = 32
                di = di + 1
            }
            first = 0
            // simple quote if space present
            var s: *u8 = *p2
            var need_q: u64 = 0
            var j: u64 = 0
            while *(s + j) != 0 {
                if *(s + j) == 32 {
                    need_q = 1
                }
                j = j + 1
            }
            if need_q != 0 {
                *(out + di) = 34
                di = di + 1
            }
            j = 0
            while *(s + j) != 0 {
                *(out + di) = *(s + j)
                di = di + 1
                j = j + 1
            }
            if need_q != 0 {
                *(out + di) = 34
                di = di + 1
            }
            p2 = cast[**u8](cast[u64](p2) + 8)
        }
    } else {
        if c.program != null {
            var s2: *u8 = c.program
            var k: u64 = 0
            while *(s2 + k) != 0 {
                *(out + di) = *(s2 + k)
                di = di + 1
                k = k + 1
            }
        }
    }
    *(out + di) = 0
    return out, 0
}

// build_env_block builds Windows environment block from envp (double-NUL terminated).
fn build_env_block(env: **u8) -> (*u8, *u8) {
    var n: u64 = 2
    var p: **u8 = env
    while *p != null {
        n = n + __strlen(*p) + 1
        p = cast[**u8](cast[u64](p) + 8)
    }
    var raw: *void
    var err: *u8
    raw, err = runtime.Alloc(n)
    if err != 0 {
        return null, err
    }
    var out: *u8 = cast[*u8](raw)
    var di: u64 = 0
    p = env
    while *p != null {
        var s: *u8 = *p
        var j: u64 = 0
        while *(s + j) != 0 {
            *(out + di) = *(s + j)
            di = di + 1
            j = j + 1
        }
        *(out + di) = 0
        di = di + 1
        p = cast[**u8](cast[u64](p) + 8)
    }
    *(out + di) = 0
    return out, 0
}

// Wait waits for the process to exit. Returns (exit_code, err).
fn Wait(c: *Cmd) -> (i32, *u8) {
    if c.started == 0 {
        return -1, "process: not started"
    }
    if c.waited != 0 {
        return c.exit_code, 0
    }
    if runtime.IsLinux() {
        var st: u64 = 0
        var wr: i64 = cast[i64](__syscall(SYS_WAIT4, c.pid, cast[u64](&st), 0, 0))
        if wr < 0 {
            return -1, "process: wait failed"
        }
        // WIFEXITED: (st & 0x7f) == 0
        if (st & 0x7f) == 0 {
            c.exit_code = cast[i32]((st >> 8) & 0xff)
        } else {
            c.exit_code = -1
        }
        c.waited = 1
        return c.exit_code, 0
    }
    if runtime.IsWindows() {
        var wf: FnWaitForSingleObject = cast[FnWaitForSingleObject](g.wait_object)
        if wf(c.h_process, W_INFINITE) != W_WAIT_OBJECT_0 {
            return -1, "process: wait failed"
        }
        var code: u32 = 0
        var ge: FnGetExitCodeProcess = cast[FnGetExitCodeProcess](g.get_exit)
        if ge(c.h_process, &code) == 0 {
            return -1, "process: exit code failed"
        }
        c.exit_code = cast[i32](code)
        c.waited = 1
        return c.exit_code, 0
    }
    return -1, "process: unknown os"
}

// Kill terminates the process.
fn Kill(c: *Cmd) -> *u8 {
    if c.started == 0 {
        return "process: not started"
    }
    if runtime.IsLinux() {
        if cast[i64](__syscall(SYS_KILL, c.pid, 9)) != 0 {
            return "process: kill failed"
        }
        return 0
    }
    if runtime.IsWindows() {
        if g.terminate == null {
            return "process: resolve failed"
        }
        var f: FnTerminateProcess = cast[FnTerminateProcess](g.terminate)
        if f(c.h_process, 1) == 0 {
            return "process: kill failed"
        }
        return 0
    }
    return "process: unknown os"
}

// Release closes pipes and Windows handles. Safe to call multiple times.
// Does not wait or kill; call Wait first if needed.
fn Release(c: *Cmd) {
    close_handle(c.stdin_w)
    c.stdin_w = INVALID
    close_handle(c.stdout_r)
    c.stdout_r = INVALID
    close_handle(c.stderr_r)
    c.stderr_r = INVALID
    close_handle(c._in_r)
    c._in_r = INVALID
    close_handle(c._out_w)
    c._out_w = INVALID
    close_handle(c._err_w)
    c._err_w = INVALID
    if runtime.IsWindows() {
        close_handle(c.h_thread)
        c.h_thread = INVALID
        close_handle(c.h_process)
        c.h_process = INVALID
    }
}

// ---------- high-level ----------

// Run starts and waits with current config. Returns (exit_code, err).
fn Run(c: *Cmd) -> (i32, *u8) {
    var err: *u8 = Start(c)
    if err != 0 {
        return -1, err
    }
    var code: i32
    code, err = Wait(c)
    Release(c)
    return code, err
}

// read_all_from reads a handle to EOF into an owning []u8.
fn read_all_from(h: Handle) -> ([]u8, *u8) {
    var empty: []u8 = make([]u8, 0, 0)
    if h == INVALID {
        return empty, 0
    }
    var s: []u8 = make([]u8, 0, 4096)
    var chunk: [4096]u8
    while 1 {
        var n: u64
        var err: *u8
        n, err = read_handle(h, &chunk[0], 4096)
        if err != 0 {
            free(s)
            return empty, err
        }
        if n == 0 {
            return s, 0
        }
        if cast[u64](len(s)) + n > MAX_OUTPUT {
            free(s)
            return empty, "process: output too large"
        }
        var i: u64 = 0
        while i < n {
            s = append(s, chunk[i])
            i = i + 1
        }
    }
    return s, 0
}

// Output runs c with stdout piped (stderr inherit unless already set to pipe).
// Returns stdout bytes; exit code in c.exit_code. Caller free(data).
fn Output(c: *Cmd) -> ([]u8, *u8) {
    var empty: []u8 = make([]u8, 0, 0)
    c.stdout_mode = STD_PIPE
    var err: *u8 = Start(c)
    if err != 0 {
        return empty, err
    }
    // close stdin if we opened a pipe unused
    CloseStdin(c)
    var data: []u8
    data, err = read_all_from(c.stdout_r)
    if err != 0 {
        Kill(c)
        Wait(c)
        Release(c)
        return empty, err
    }
    var code: i32
    code, err = Wait(c)
    c.exit_code = code
    Release(c)
    if err != 0 {
        free(data)
        return empty, err
    }
    return data, 0
}

// CombinedOutput pipes stdout+stderr into one stream (stderr dup'd to stdout on Linux;
// on Windows both handles set to the same write pipe).
fn CombinedOutput(c: *Cmd) -> ([]u8, *u8) {
    var empty: []u8 = make([]u8, 0, 0)
    c.stdout_mode = STD_PIPE
    c.stderr_mode = STD_PIPE
    // We'll merge by reading both - simpler portable approach:
    var err: *u8 = Start(c)
    if err != 0 {
        return empty, err
    }
    CloseStdin(c)
    // read stdout fully first then stderr (fine for moderate output)
    var out: []u8
    out, err = read_all_from(c.stdout_r)
    if err != 0 {
        Kill(c)
        Wait(c)
        Release(c)
        return empty, err
    }
    var errb: []u8
    errb, err = read_all_from(c.stderr_r)
    if err != 0 {
        free(out)
        Kill(c)
        Wait(c)
        Release(c)
        return empty, err
    }
    // append stderr to stdout
    var i: u64 = 0
    while i < cast[u64](len(errb)) {
        out = append(out, errb[i])
        i = i + 1
    }
    free(errb)
    var code: i32
    code, err = Wait(c)
    c.exit_code = code
    Release(c)
    if err != 0 {
        free(out)
        return empty, err
    }
    return out, 0
}

// ---------- shell helpers ----------

// Shell runs a command line via the platform shell (/bin/sh -c or cmd.exe /c).
fn Shell(line: *u8) -> (i32, *u8) {
    if line == null {
        return -1, "process: null command"
    }
    return run_shell_line(line, 0)
}

// run_shell_line kind: 0=sh/cmd 1=bash 2=powershell
// Argv storage is embedded in Cmd so it outlives helper frames across fork.
fn run_shell_line(line: *u8, kind: u64) -> (i32, *u8) {
    var c: Cmd
    Zero(&c)
    c.hide_window = 1

    if runtime.IsWindows() {
        var errw: *u8 = 0
        if kind == 2 {
            c.program = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
            errw = win_cmdline(&c, "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command ", line)
        } else {
            if kind == 1 {
                c.program = "bash.exe"
                errw = win_cmdline(&c, "bash.exe -c ", line)
            } else {
                c.program = "C:\\Windows\\System32\\cmd.exe"
                errw = win_cmdline(&c, "cmd.exe /c ", line)
            }
        }
        if errw != 0 {
            return -1, errw
        }
        return Run(&c)
    }

    // Linux: store argv pointers in the Cmd-adjacent stack via fixed locals
    // that we take addresses of only after all are set.
    if kind == 2 {
        c.program = "/usr/bin/pwsh"
        c._a0 = "pwsh"
        c._a1 = "-NonInteractive"
        c._a2 = "-Command"
        c._a3 = line
        c._a4 = null
        c.argv = cast[**u8](&c._a0)
    } else {
        if kind == 1 {
            c.program = "/bin/bash"
            c._a0 = "bash"
            c._a1 = "-c"
            c._a2 = line
            c._a3 = null
            c.argv = cast[**u8](&c._a0)
        } else {
            c.program = "/bin/sh"
            c._a0 = "sh"
            c._a1 = "-c"
            c._a2 = line
            c._a3 = null
            c.argv = cast[**u8](&c._a0)
        }
    }
    return Run(&c)
}

// ShellOutput runs via shell and captures stdout.
fn ShellOutput(line: *u8) -> ([]u8, *u8) {
    return run_shell_output(line, 0)
}

// Bash runs via /bin/bash -c (Linux) or bash.exe -c (Windows if present).
fn Bash(line: *u8) -> (i32, *u8) {
    return run_shell_line(line, 1)
}

// BashOutput captures stdout from bash -c.
fn BashOutput(line: *u8) -> ([]u8, *u8) {
    return run_shell_output(line, 1)
}

// PowerShell runs via powershell.exe -NoProfile -NonInteractive -Command (Windows),
// or pwsh -NonInteractive -Command when available on Linux.
fn PowerShell(line: *u8) -> (i32, *u8) {
    return run_shell_line(line, 2)
}

// PowerShellOutput captures stdout from PowerShell.
fn PowerShellOutput(line: *u8) -> ([]u8, *u8) {
    return run_shell_output(line, 2)
}

// run_shell_output is Output() after configuring a shell line.
fn run_shell_output(line: *u8, kind: u64) -> ([]u8, *u8) {
    var empty: []u8 = make([]u8, 0, 0)
    if line == null {
        return empty, "process: null command"
    }
    var c: Cmd
    Zero(&c)
    c.hide_window = 1
    if runtime.IsWindows() {
        var errw: *u8 = 0
        if kind == 2 {
            c.program = "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
            errw = win_cmdline(&c, "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command ", line)
        } else {
            if kind == 1 {
                c.program = "bash.exe"
                errw = win_cmdline(&c, "bash.exe -c ", line)
            } else {
                c.program = "C:\\Windows\\System32\\cmd.exe"
                errw = win_cmdline(&c, "cmd.exe /c ", line)
            }
        }
        if errw != 0 {
            return empty, errw
        }
    } else {
        if kind == 2 {
            c.program = "/usr/bin/pwsh"
            c._a0 = "pwsh"
            c._a1 = "-NonInteractive"
            c._a2 = "-Command"
            c._a3 = line
            c._a4 = null
            c.argv = cast[**u8](&c._a0)
        } else {
            if kind == 1 {
                c.program = "/bin/bash"
                c._a0 = "bash"
                c._a1 = "-c"
                c._a2 = line
                c._a3 = null
                c.argv = cast[**u8](&c._a0)
            } else {
                c.program = "/bin/sh"
                c._a0 = "sh"
                c._a1 = "-c"
                c._a2 = line
                c._a3 = null
                c.argv = cast[**u8](&c._a0)
            }
        }
    }
    var data: []u8
    var err: *u8
    data, err = Output(&c)
    if c.cmdline != null {
        runtime.Free(cast[*void](c.cmdline))
        c.cmdline = null
    }
    return data, err
}

fn win_cmdline(c: *Cmd, prefix: *u8, line: *u8) -> *u8 {
    var n: u64 = __strlen(prefix) + __strlen(line) + 4
    var raw: *void
    var err: *u8
    raw, err = runtime.Alloc(n)
    if err != 0 {
        return err
    }
    var out: *u8 = cast[*u8](raw)
    var di: u64 = 0
    var s: *u8 = prefix
    var j: u64 = 0
    while *(s + j) != 0 {
        *(out + di) = *(s + j)
        di = di + 1
        j = j + 1
    }
    *(out + di) = 34
    di = di + 1
    j = 0
    while *(line + j) != 0 {
        *(out + di) = *(line + j)
        di = di + 1
        j = j + 1
    }
    *(out + di) = 34
    di = di + 1
    *(out + di) = 0
    c.cmdline = out
    return 0
}

// kind: 0=sh/cmd, 1=bash, 2=powershell
// argv lives on this frame until Run/Start completes (fork copies).

// System is an alias for Shell (exit code only interest).
fn System(line: *u8) -> (i32, *u8) {
    return Shell(line)
}

// SelfTest runs /bin/true via Shell.
fn SelfTest() -> (i32, *u8) {
    return Shell("true")
}
