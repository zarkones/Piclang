// Package wresolve - Windows x64 PEB module + export resolve.
// Used by std/runtime; import path: "std/windows/resolve"
package wresolve

type PVOID = *void
type ULONG = u32
type USHORT = u16

struct LIST_ENTRY {
    Flink: *LIST_ENTRY
    Blink: *LIST_ENTRY
}

struct PEB_LDR_DATA {
    Length: ULONG
    Initialized: u8
    _pad0: u8
    _pad1: u8
    _pad2: u8
    SsHandle: PVOID
    InLoadOrderModuleList: LIST_ENTRY
}

struct PEB {
    InheritedAddressSpace: u8
    ReadImageFileExecOptions: u8
    BeingDebugged: u8
    BitField: u8
    _pad0: u32
    Mutant: PVOID
    ImageBaseAddress: PVOID
    Ldr: *PEB_LDR_DATA
}

struct IMAGE_DOS_HEADER {
    eMagic: USHORT
    eCblp: USHORT
    eCp: USHORT
    eCrlc: USHORT
    eCparhdr: USHORT
    eMinalloc: USHORT
    eMaxalloc: USHORT
    eSs: USHORT
    eSp: USHORT
    eCsum: USHORT
    eIp: USHORT
    eCs: USHORT
    eLfarlc: USHORT
    eOvno: USHORT
    eRes0: USHORT
    eRes1: USHORT
    eRes2: USHORT
    eRes3: USHORT
    eOemid: USHORT
    eOeminfo: USHORT
    eRes20: USHORT
    eRes21: USHORT
    eRes22: USHORT
    eRes23: USHORT
    eRes24: USHORT
    eRes25: USHORT
    eRes26: USHORT
    eRes27: USHORT
    eRes28: USHORT
    eRes29: USHORT
    eLfanew: i32
}

fn hashWstr(buf: *u16, nBytes: u64) -> u32 {
    var h: u32 = 5381
    var i: u64 = 0
    while i < nBytes {
        var ch: u16 = __load16(cast[*void](cast[u64](buf) + i))
        var c: u32 = cast[u32](ch & 0xFF)
        if c >= 0x61 {
            if c <= 0x7A {
                c = c - 0x20
            }
        }
        h = ((h << 5) + h) + c
        i = i + 2
    }
    return h
}

fn getPeb() -> *PEB {
    return cast[*PEB](__readgs(0x60))
}

// Probe returns true if GS:[0x60] looks like a Windows x64 PEB.
fn Probe() -> bool {
    var pebU: u64 = __readgs(0x60)
    if pebU == 0 {
        return false
    }
    if (pebU & 7) != 0 {
        return false
    }
    var peb: *PEB = cast[*PEB](pebU)
    var ldr: *PEB_LDR_DATA = peb.Ldr
    if ldr == null {
        return false
    }
    // ImageBase should look like a PE if present
    var img: PVOID = peb.ImageBaseAddress
    if img != null {
        var mag: u16 = __load16(img)
        if mag != 0x5A4D {
            return false
        }
    }
    return true
}

// ProcessHeap returns PEB->ProcessHeap (x64 offset 0x30).
fn ProcessHeap() -> PVOID {
    var peb: u64 = __readgs(0x60)
    if peb == 0 {
        return null
    }
    return cast[PVOID](__load64(cast[*void](peb + 0x30)))
}

// Module finds a loaded DLL by djb2 hash of BaseDllName (UTF-16).
fn Module(want: u32) -> PVOID {
    if !Probe() {
        return null
    }
    var peb: *PEB = getPeb()
    var ldr: *PEB_LDR_DATA = peb.Ldr
    var head: *LIST_ENTRY = cast[*LIST_ENTRY](cast[u64](ldr) + 0x10)
    var cur: *LIST_ENTRY = head.Flink
    while cur != head {
        var ent: PVOID = cast[PVOID](cur)
        // BaseDllName: Length @ +88, Buffer @ +96 (x64 LDR_DATA_TABLE_ENTRY simplified)
        var nameLen: u16 = __load16(cast[*void](cast[u64](ent) + 88))
        var nameBuf: *u16 = cast[*u16](__load64(cast[*void](cast[u64](ent) + 96)))
        if nameBuf != null {
            if nameLen != 0 {
                var h: u32 = hashWstr(nameBuf, cast[u64](nameLen))
                if h == want {
                    // DllBase at +48 after 3 LIST_ENTRY (24*2? wait 16*3=48)
                    return cast[PVOID](__load64(cast[*void](cast[u64](ent) + 48)))
                }
            }
        }
        cur = cur.Flink
    }
    return null
}

// Symbol resolves a PE export by djb2 hash of the ASCII name.
fn Symbol(base: PVOID, want: u32) -> PVOID {
    if base == null {
        return null
    }
    var dos: *IMAGE_DOS_HEADER = cast[*IMAGE_DOS_HEADER](base)
    if dos.eMagic != 0x5A4D {
        return null
    }
    var nt: u64 = cast[u64](base) + cast[u64](dos.eLfanew)
    var opt: u64 = nt + 24
    if __load16(cast[*void](opt)) != 0x20B {
        return null
    }
    var exportRva: u32 = __load32(cast[*void](opt + 112))
    if exportRva == 0 {
        return null
    }
    var exp: u64 = cast[u64](base) + cast[u64](exportRva)
    var nNames: u32 = __load32(cast[*void](exp + 0x18))
    var addrFuncs: u32 = __load32(cast[*void](exp + 0x1C))
    var addrNames: u32 = __load32(cast[*void](exp + 0x20))
    var addrOrds: u32 = __load32(cast[*void](exp + 0x24))
    var i: u32 = 0
    while i < nNames {
        var nameRva: u32 = __load32(cast[*void](cast[u64](base) + cast[u64](addrNames) + cast[u64](i) * 4))
        var namep: *u8 = cast[*u8](cast[u64](base) + cast[u64](nameRva))
        if __hash(namep) == want {
            var ord: u16 = __load16(cast[*void](cast[u64](base) + cast[u64](addrOrds) + cast[u64](i) * 2))
            var fnRva: u32 = __load32(cast[*void](cast[u64](base) + cast[u64](addrFuncs) + cast[u64](ord) * 4))
            return cast[PVOID](cast[u64](base) + cast[u64](fnRva))
        }
        i = i + 1
    }
    return null
}
