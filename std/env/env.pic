// Package env - dual-OS environment variables.
// Get/Lookup always return a heap copy; caller must runtime.Free.
// Requires runtime.Init first.
package env

import "std/runtime"
import "std/mem"
import lresolve "std/linux/resolve"
import wresolve "std/windows/resolve"

type PVOID = *void

type FnGetEnv = fn(*u8) -> *u8
type FnSetEnv = fn(*u8, *u8, i32) -> i32
type FnUnsetEnv = fn(*u8) -> i32
type FnGetEnvironmentVariableA = fn(*u8, *u8, u32) -> u32
type FnSetEnvironmentVariableA = fn(*u8, *u8) -> u32

struct State {
    ready: u64
    getenv: PVOID
    setenv: PVOID
    unsetenv: PVOID
    getEnvW: PVOID
    setEnvW: PVOID
}

var g: State

fn ensure() -> *u8 {
    if g.ready != 0 {
        return 0
    }
    if !runtime.Ready() {
        return "env: runtime not ready"
    }
    if runtime.IsLinux() {
        var hint: PVOID = runtime.StackHint()
        var libc: PVOID = lresolve.Module(__hash("libc.so.6"), hint)
        if libc == null {
            libc = lresolve.Module(__hash("libc.so"), hint)
        }
        if libc == null {
            return "env: resolve failed"
        }
        g.getenv = lresolve.Symbol(libc, __hash("getenv"))
        g.setenv = lresolve.Symbol(libc, __hash("setenv"))
        g.unsetenv = lresolve.Symbol(libc, __hash("unsetenv"))
        if g.getenv == null {
            return "env: resolve failed"
        }
        g.ready = 1
        return 0
    }
    if runtime.IsWindows() {
        var k32: PVOID = wresolve.Module(__hash("KERNEL32.DLL"))
        if k32 == null {
            return "env: resolve failed"
        }
        g.getEnvW = wresolve.Symbol(k32, __hash("GetEnvironmentVariableA"))
        g.setEnvW = wresolve.Symbol(k32, __hash("SetEnvironmentVariableA"))
        if g.getEnvW == null {
            return "env: resolve failed"
        }
        g.ready = 1
        return 0
    }
    return "env: unknown os"
}

fn dupCstr(s: *u8) -> (*u8, *u8) {
    if s == null {
        var raw: *void
        var err: *u8
        raw, err = runtime.Alloc(1)
        if err != 0 {
            return null, err
        }
        *cast[*u8](raw) = 0
        return cast[*u8](raw), 0
    }
    var n: u64 = __strlen(s)
    var raw2: *void
    var err2: *u8
    raw2, err2 = runtime.Alloc(n + 1)
    if err2 != 0 {
        return null, err2
    }
    mem.Copy(raw2, cast[*void](s), n + 1)
    return cast[*u8](raw2), 0
}

// Get returns a heap copy of the value, or empty string if unset.
// err is non-null only on OS/runtime failure (not for missing keys).
// Caller runtime.Free's the result.
fn Get(key: *u8) -> (*u8, *u8) {
    var val: *u8
    var ok: bool
    var err: *u8
    val, ok, err = Lookup(key)
    if err != 0 {
        return null, err
    }
    if !ok {
        // empty string
        return dupCstr(cast[*u8](null))
    }
    return val, 0
}

// Lookup returns (value, present, err). value is heap copy if present.
// Caller runtime.Free when present (or always if non-null).
fn Lookup(key: *u8) -> (*u8, bool, *u8) {
    var err: *u8 = ensure()
    if err != 0 {
        return null, false, err
    }
    if key == null {
        return null, false, "env: null key"
    }
    if runtime.IsLinux() {
        // libc getenv is SysV - use __sysv_call, not MS x64 indirect call
        var v: *u8 = cast[*u8](__sysv_call(g.getenv, cast[u64](key)))
        if v == null {
            return null, false, 0
        }
        var dup: *u8
        dup, err = dupCstr(v)
        if err != 0 {
            return null, false, err
        }
        return dup, true, 0
    }
    if runtime.IsWindows() {
        var f2: FnGetEnvironmentVariableA = cast[FnGetEnvironmentVariableA](g.getEnvW)
        // size query
        var need: u32 = f2(key, null, 0)
        if need == 0 {
            return null, false, 0
        }
        var raw: *void
        raw, err = runtime.Alloc(cast[u64](need))
        if err != 0 {
            return null, false, err
        }
        var buf: *u8 = cast[*u8](raw)
        var got: u32 = f2(key, buf, need)
        if got == 0 {
            runtime.Free(raw)
            return null, false, 0
        }
        return buf, true, 0
    }
    return null, false, "env: unknown os"
}

// GetOr returns Get(key) or a heap copy of def if missing.
fn GetOr(key: *u8, def: *u8) -> (*u8, *u8) {
    var val: *u8
    var ok: bool
    var err: *u8
    val, ok, err = Lookup(key)
    if err != 0 {
        return null, err
    }
    if ok {
        return val, 0
    }
    return dupCstr(def)
}

// Set sets key=val in the process environment.
fn Set(key: *u8, val: *u8) -> *u8 {
    var err: *u8 = ensure()
    if err != 0 {
        return err
    }
    if key == null {
        return "env: null key"
    }
    if val == null {
        return Unset(key)
    }
    if runtime.IsLinux() {
        if g.setenv == null {
            return "env: setenv unavailable"
        }
        if cast[i64](__sysv_call(g.setenv, cast[u64](key), cast[u64](val), 1)) != 0 {
            return "env: set failed"
        }
        return 0
    }
    if runtime.IsWindows() {
        if g.setEnvW == null {
            return "env: set unavailable"
        }
        var f2: FnSetEnvironmentVariableA = cast[FnSetEnvironmentVariableA](g.setEnvW)
        if f2(key, val) == 0 {
            return "env: set failed"
        }
        return 0
    }
    return "env: unknown os"
}

// Unset removes key from the environment.
fn Unset(key: *u8) -> *u8 {
    var err: *u8 = ensure()
    if err != 0 {
        return err
    }
    if key == null {
        return "env: null key"
    }
    if runtime.IsLinux() {
        if g.unsetenv == null {
            return "env: unsetenv unavailable"
        }
        if cast[i64](__sysv_call(g.unsetenv, cast[u64](key))) != 0 {
            return "env: unset failed"
        }
        return 0
    }
    if runtime.IsWindows() {
        if g.setEnvW == null {
            return "env: unset unavailable"
        }
        var f: FnSetEnvironmentVariableA = cast[FnSetEnvironmentVariableA](g.setEnvW)
        // SetEnvironmentVariableA(name, NULL) deletes
        if f(key, null) == 0 {
            return "env: unset failed"
        }
        return 0
    }
    return "env: unknown os"
}
