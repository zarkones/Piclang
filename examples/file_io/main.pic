// file_io - dual-OS file package demo (WriteString / ReadAll / Remove).
//
//   picc examples/file_io/main.pic -o file_io.bin -rand-sections=false
//   ./harness/run_shellcode file_io.bin   # returns 0 on Linux
//
// Writes /tmp/piclang_file_io_test.txt, reads it back, deletes it.
package main

import "std/runtime"
import "std/file"

fn main(stack_hint: *void) -> u64 {
    if !runtime.Init(stack_hint) {
        return 1
    }

    var path: *u8 = "piclang_file_io_test.txt"
    var err: *u8 = file.WriteString(path, "hello file")
    if err != 0 {
        return 2
    }

    data, err2 := file.ReadAll(path)
    if err2 != 0 {
        return 3
    }
    defer free(data)
    
    var out_path: *u8 = "outttt.txt"
    var werr: *u8 = file.WriteAll(out_path, data, 11)


    // if len(data) != 10 {
    //     return 4
    // }
    // // 'h' = 104, 'f' of "file" at index 6
    // if data[0] != 104 {
    //     return 5
    // }
    // if data[6] != 102 {
    //     return 6
    // }

    // var err3: *u8 = file.Remove(path)
    // if err3 != 0 {
    //     return 7
    // }

    // // Missing path must fail
    // _, err4 := file.ReadAll(path)
    // if err4 == 0 {
    //     return 8
    // }

    return 0
}
