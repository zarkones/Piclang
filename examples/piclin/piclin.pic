// piclin.pic - Linux x8664 position-independent implant (research PoC)
//
// Port of /home/user/Desktop/projects/piclin to Piclang.
// Stardust-inspired: RIP base, page-aligned globals, runtime resolve.
//
// Flow (ELF analogue of PEB walk):
//   1. Entry passes stack frame as stackHint (return addr at [hint+8])
//   2. Page-walk from loader retaddr -> ELF header of main / ld.so
//   3. PT_DYNAMIC / DT_DEBUG -> rDebug -> linkMap list
//   4. Match libc by djb2 hash of basename ("libc.so.6")
//   5. Dynsym scan for open/write/close/exit by hash
//   6. open("test.txt") / write("success") / close / exit
//
// Build:  picc examples/piclin/piclin.pic -o examples/piclin/piclin.bin -S
// Run:    map RWX + call (harness), then cat test.txt -> "success"
//
// Libc is invoked with __sysv_call (System V AMD64), not the default MS x64
// convention used for Piclang-internal calls.

type PVOID = *void
type sizeT = u64
type uintptr = u64

// ---- ELF / dynamic linker constants ----
const ELFMAG = 0x464C457F       // \x7fELF little-endian u32
const ELFCLASS64 = 2
const ELFDATA2LSB = 1
const ET_EXEC = 2
const ET_DYN = 3
const PT_LOAD = 1
const PT_DYNAMIC = 2
const DT_NULL = 0
const DT_HASH = 4
const DT_STRTAB = 5
const DT_SYMTAB = 6
const DT_DEBUG = 21
const DT_GNU_HASH = 0x6FFFFEF5
const STB_GLOBAL = 1
const STB_WEAK = 2
const STT_NOTYPE = 0
const STT_OBJECT = 1
const STT_FUNC = 2
const SHN_UNDEF = 0

// open flags
const O_WRONLY = 1
const O_CREAT = 64
const O_TRUNC = 512
const O_FLAGS = 577             // O_CREAT|O_WRONLY|O_TRUNC
const MODE_0644 = 420           // 0644

// Struct sizes (x8664)
const SIZE_EHDR = 64
const SIZE_PHDR = 56
const SIZE_DYN = 16
const SIZE_SYM = 24

// ---- Layout helpers (raw offsets; matches Linux ABI) ----
// Elf64_Ehdr
//   eIdent[16]@0  eType@16  eMachine@18  eVersion@20
//   eEntry@24  ePhoff@32  eShoff@40  eFlags@48
//   eEhsize@52  ePhentsize@54  ePhnum@56
// Elf64_Phdr
//   pType@0  pFlags@4  pOffset@8  pVaddr@16  pPaddr@24
//   pFilesz@32  pMemsz@40  pAlign@48
// Elf64_Dyn: dTag@0 (i64)  dVal/dPtr@8
// Elf64_Sym: stName@0  stInfo@4  stOther@5  stShndx@6  stValue@8  stSize@16
// rDebug: rVersion@0  rMap@8
// linkMap: lAddr@0  lName@8  lLd@16  lNext@24  lPrev@32

// Global implant instance (page-aligned .global section)
struct Instance {
    baseBuffer: PVOID
    baseLength: u64
    libc: PVOID
    open: PVOID
    write: PVOID
    close: PVOID
    exitFn: PVOID
}

var gInst: Instance

// ---- memory / string helpers ----

fn pathBasename(path: *u8) -> *u8 {
    var base: *u8 = path
    if path == null {
        return path
    }
    var p: *u8 = path
    while *p != 0 {
        if *p == 0x2F {
            base = p + 1
        }
        p = p + 1
    }
    return base
}

fn hashString(s: *u8) -> u32 {
    return __hash(s)
}

// ---- ELF helpers ----

fn elfValid(base: PVOID) -> u64 {
    if base == null {
        return 0
    }
    var mag: u32 = __load32(base)
    if mag != ELFMAG {
        return 0
    }
    var cls: u8 = __load8(cast[*void](cast[u64](base) + 4))
    var data: u8 = __load8(cast[*void](cast[u64](base) + 5))
    if cls != ELFCLASS64 {
        return 0
    }
    if data != ELFDATA2LSB {
        return 0
    }
    var etype: u16 = __load16(cast[*void](cast[u64](base) + 16))
    if etype != ET_EXEC {
        if etype != ET_DYN {
            return 0
        }
    }
    return 1
}

fn findElfHeader(hint: PVOID, maxPages: u64) -> PVOID {
    var addr: u64 = cast[u64](hint) & 0xFFFFFFFFFFFFF000
    var i: u64 = 0
    while i < maxPages {
        if elfValid(cast[PVOID](addr)) != 0 {
            return cast[PVOID](addr)
        }
        if addr < 0x1000 {
            return null
        }
        addr = addr - 0x1000
        i = i + 1
    }
    return null
}

fn elfLoadBias(base: PVOID) -> u64 {
    var phoff: u64 = __load64(cast[*void](cast[u64](base) + 32))
    var phnum: u16 = __load16(cast[*void](cast[u64](base) + 56))
    var ph: u64 = cast[u64](base) + phoff
    var i: u16 = 0
    while i < phnum {
        var pType: u32 = __load32(cast[*void](ph))
        if pType == PT_LOAD {
            var pVaddr: u64 = __load64(cast[*void](ph + 16))
            return cast[u64](base) - pVaddr
        }
        ph = ph + SIZE_PHDR
        i = i + 1
    }
    return cast[u64](base)
}

fn elfDynamic(base: PVOID) -> PVOID {
    var phoff: u64 = __load64(cast[*void](cast[u64](base) + 32))
    var phnum: u16 = __load16(cast[*void](cast[u64](base) + 56))
    var bias: u64 = elfLoadBias(base)
    var ph: u64 = cast[u64](base) + phoff
    var i: u16 = 0
    while i < phnum {
        var pType: u32 = __load32(cast[*void](ph))
        if pType == PT_DYNAMIC {
            var pVaddr: u64 = __load64(cast[*void](ph + 16))
            return cast[PVOID](bias + pVaddr)
        }
        ph = ph + SIZE_PHDR
        i = i + 1
    }
    return null
}

fn elfRDebug(base: PVOID) -> PVOID {
    var dyn: PVOID = elfDynamic(base)
    if dyn == null {
        return null
    }
    var d: u64 = cast[u64](dyn)
    while 1 {
        var tag: i64 = cast[i64](__load64(cast[*void](d)))
        if tag == DT_NULL {
            return null
        }
        if tag == DT_DEBUG {
            var ptr: u64 = __load64(cast[*void](d + 8))
            if ptr == 0 {
                return null
            }
            // rMap at offset 8 of rDebug
            var rMap: u64 = __load64(cast[*void](ptr + 8))
            if rMap == 0 {
                return null
            }
            return cast[PVOID](ptr)
        }
        d = d + SIZE_DYN
    }
    return null
}

// Discover rDebug: page-walk from loader return address, then auxv-ish scan.
fn findRDebug(stackHint: PVOID) -> PVOID {
    if stackHint != null {
        // [rbp+8] = return address into the loader that called the implant
        var retaddr: PVOID = cast[PVOID](__load64(cast[*void](cast[u64](stackHint) + 8)))
        var elf: PVOID = findElfHeader(retaddr, 0x10000)
        if elf != null {
            var dbg: PVOID = elfRDebug(elf)
            if dbg != null {
                return dbg
            }
        }
    }

    if stackHint != null {
        var sp: *u64 = cast[*u64](stackHint)
        var i: u64 = 0
        while i < 0x400 {
            // AT_PHDR = 3
            if sp[i] == 3 {
                if sp[i + 1] > 0x1000 {
                    var phdr: PVOID = cast[PVOID](sp[i + 1])
                    var base: PVOID = findElfHeader(phdr, 0x100)
                    if base != null {
                        var dbg2: PVOID = elfRDebug(base)
                        if dbg2 != null {
                            return dbg2
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    return null
}

fn linkMapBase(lm: PVOID) -> PVOID {
    if lm == null {
        return null
    }
    var lLd: PVOID = cast[PVOID](__load64(cast[*void](cast[u64](lm) + 16)))
    if lLd != null {
        var elf: PVOID = findElfHeader(lLd, 0x1000)
        if elf != null {
            return elf
        }
    }
    var lAddr: u64 = __load64(lm)
    if lAddr != 0 {
        if elfValid(cast[PVOID](lAddr)) != 0 {
            return cast[PVOID](lAddr)
        }
    }
    return cast[PVOID](lAddr)
}

// Find loaded module by djb2 hash of basename (or full path).
fn resolveModule(nameHash: u32, stackHint: PVOID) -> PVOID {
    var dbg: PVOID = findRDebug(stackHint)
    if dbg == null {
        return null
    }
    var lm: PVOID = cast[PVOID](__load64(cast[*void](cast[u64](dbg) + 8)))
    while lm != null {
        var lName: *u8 = cast[*u8](__load64(cast[*void](cast[u64](lm) + 8)))
        if lName != null {
            if *lName != 0 {
                var baseName: *u8 = pathBasename(lName)
                if hashString(baseName) == nameHash {
                    return linkMapBase(lm)
                }
                if hashString(lName) == nameHash {
                    return linkMapBase(lm)
                }
            }
        }
        lm = cast[PVOID](__load64(cast[*void](cast[u64](lm) + 24)))
    }
    return null
}

// Resolve export from module by djb2 hash of symbol name (linear dynsym scan).
fn resolveSymbol(moduleBase: PVOID, funcHash: u32) -> PVOID {
    if moduleBase == null {
        return null
    }
    if elfValid(moduleBase) == 0 {
        return null
    }

    var bias: u64 = elfLoadBias(moduleBase)
    var dyn: PVOID = elfDynamic(moduleBase)
    if dyn == null {
        return null
    }

    var symtab: u64 = 0
    var strtab: u64 = 0
    var nchain: u32 = 0

    var d: u64 = cast[u64](dyn)
    while 1 {
        var tag: i64 = cast[i64](__load64(cast[*void](d)))
        if tag == DT_NULL {
            break
        }
        var ptr: u64 = __load64(cast[*void](d + 8))
        if tag == DT_SYMTAB {
            symtab = ptr
            if symtab < 0x10000 {
                symtab = bias + ptr
            }
        }
        if tag == DT_STRTAB {
            strtab = ptr
            if strtab < 0x10000 {
                strtab = bias + ptr
            }
        }
        if tag == DT_HASH {
            var h: u64 = ptr
            if h < 0x10000 {
                h = bias + ptr
            }
            // SysV hash: nchain is second u32
            nchain = __load32(cast[*void](h + 4))
        }
        d = d + SIZE_DYN
    }

    if symtab == 0 {
        return null
    }
    if strtab == 0 {
        return null
    }

    var maxSym: u32 = nchain
    if maxSym == 0 {
        maxSym = 0x8000
    }

    var i: u32 = 0
    while i < maxSym {
        var sym: u64 = symtab + cast[u64](i) * SIZE_SYM
        var stName: u32 = __load32(cast[*void](sym))
        if stName != 0 {
            var s: *u8 = cast[*u8](strtab + cast[u64](stName))
            if s != null {
                if *s != 0 {
                    if hashString(s) == funcHash {
                        var stInfo: u8 = __load8(cast[*void](sym + 4))
                        var bind: u8 = cast[u8](stInfo >> 4)
                        var typ: u8 = cast[u8](stInfo & 0xF)
                        var okBind: u64 = 0
                        if bind == STB_GLOBAL {
                            okBind = 1
                        }
                        if bind == STB_WEAK {
                            okBind = 1
                        }
                        var okType: u64 = 0
                        if typ == STT_FUNC {
                            okType = 1
                        }
                        if typ == STT_NOTYPE {
                            okType = 1
                        }
                        if typ == STT_OBJECT {
                            okType = 1
                        }
                        if okBind != 0 {
                            if okType != 0 {
                                var stShndx: u16 = __load16(cast[*void](sym + 6))
                                var stValue: u64 = __load64(cast[*void](sym + 8))
                                if stShndx != SHN_UNDEF {
                                    if stValue != 0 {
                                        return cast[PVOID](bias + stValue)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return null
}

// ---- payload ----

fn preMain(stackHint: PVOID) {
    __memset(cast[*void](&gInst), 0, sizeof(Instance))

    gInst.baseBuffer = cast[PVOID](__base())
    gInst.baseLength = __end() - __base()

    // Compile-time djb2 hashes (uppercase) - same as original piclin / Stardust
    var H_LIBC_SO_6: u32 = __hash("libc.so.6")
    var H_LIBC_SO: u32 = __hash("libc.so")
    var H_OPEN: u32 = __hash("open")
    var H_WRITE: u32 = __hash("write")
    var H_CLOSE: u32 = __hash("close")
    var H_EXIT: u32 = __hash("exit")

    var libc: PVOID = resolveModule(H_LIBC_SO_6, stackHint)
    if libc == null {
        libc = resolveModule(H_LIBC_SO, stackHint)
    }
    if libc == null {
        return
    }

    gInst.libc = libc
    gInst.open = resolveSymbol(libc, H_OPEN)
    gInst.write = resolveSymbol(libc, H_WRITE)
    gInst.close = resolveSymbol(libc, H_CLOSE)
    gInst.exitFn = resolveSymbol(libc, H_EXIT)

    if gInst.open == null {
        return
    }
    if gInst.write == null {
        return
    }
    if gInst.close == null {
        return
    }
    if gInst.exitFn == null {
        return
    }

    doMain()
}

// Create test.txt with contents "success", then exit via resolved libc.
fn doMain() {
    // Normal string literals - compiler places them in .rdata (PIC-safe)
    var path: *u8 = "test.txt"
    var msg: *u8 = "success"
    var len: u64 = 7

    // open(path, O_CREAT|O_WRONLY|O_TRUNC, 0644) - SysV calling convention
    var fd: i64 = cast[i64](__sysv_call(gInst.open, cast[u64](path), O_FLAGS, MODE_0644))
    if fd < 0 {
        __sysv_call(gInst.exitFn, 1)
        return
    }

    var wr: i64 = cast[i64](__sysv_call(gInst.write, cast[u64](fd), cast[u64](msg), len))
    if wr != cast[i64](len) {
        __sysv_call(gInst.close, cast[u64](fd))
        __sysv_call(gInst.exitFn, 1)
        return
    }

    __sysv_call(gInst.close, cast[u64](fd))
    __sysv_call(gInst.exitFn, 0)
}

// Entry: stackHint is the implant frame pointer (RCX from entry stub).
// [stackHint+8] is the return address into the host loader.
fn main(stackHint: PVOID) -> u64 {
    preMain(stackHint)
    return 0
}
