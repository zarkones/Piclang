// agentSkeleton.pic - minimal implant-shaped program structure.
// OS-agnostic language features; Windows PEB bits are optional helpers.

type PVOID = *void
type DWORD = u32

struct Context {
    base: u64
    size: u64
    beacon: PVOID
    sleepMs: DWORD
}

var gCtx: Context

fn initCtx() {
    gCtx.base = __base()
    gCtx.size = __end() - __base()
    gCtx.beacon = null
    gCtx.sleepMs = 5000
}

fn checkinMsg() -> *u8 {
    // Compiler emits this into .rdata; RIP-relative access at runtime.
    return "agent/checkin"
}

fn xorDecode(buf: *u8, n: u64, key: u8) {
    var i: u64 = 0
    while i < n {
        var p: *u8 = buf + i
        *p = cast[u8](cast[u64](*p) ^ cast[u64](key))
        i = i + 1
    }
}

fn main() -> u64 {
    initCtx()

    var msg: *u8 = checkinMsg()
    var n: u64 = __strlen(msg)

    // Local working buffer (stack)
    var scratch: u64 = 0
    var p: *u8 = cast[*u8](&scratch)

    // Demonstrate memcpy/memset builtins
    __memset(cast[*void](p), 0, 8)
    if n > 0 {
        if n > 8 {
            n = 8
        }
        __memcpy(cast[*void](p), cast[*void](msg), n)
    }

    // Compile-time API hash for later resolution
    var h: u32 = __hash("VirtualAlloc")

    return gCtx.size + cast[u64](h) + n
}
