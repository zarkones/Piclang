// slices demo - full []T with make/append/index/subslice/copy/free
//
//   picc examples/slices/main.pic -o slices.bin -rand-sections=false
//   ./harness/runShellcode slices.bin   # returns 10
package main

import "std/runtime"

fn main(stackHint: *void) -> u64 {
    if !runtime.Init(stackHint) {
        return 1
    }

    var s: []u64 = make([]u64, 0, 2)
    s = append(s, 1)
    s = append(s, 2)
    s = append(s, 3) // may grow (frees previous backing if owns)
    s = append(s, 4)
    // defer free after final append - free() captures the header at defer time
    defer free(s)

    var view: []u64 = s[1:3] // view: owns=false; never free(view)
    if len(view) != 2 {
        return 2
    }
    if view[0] != 2 {
        return 3
    }

    var d: []u64 = make([]u64, 4, 4)
    var n: u64 = copy(d, s)
    if n != 4 {
        free(d)
        return 4
    }

    var sum: u64 = 0
    var i: u64 = 0
    while i < len(d) {
        sum = sum + d[i]
        i = i + 1
    }
    free(d)
    return sum // 10
}
