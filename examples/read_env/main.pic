// picc examples/read_env/main.pic -o read_env.bin -rand-sections=false
// ./harness/run_shellcode read_env.bin
package main

import "std/runtime"
import "std/env"

fn main(stackHint: *void) -> u64 {
    if !runtime.Init(stackHint) {
        return 1
    }
    if env.Set("PICLANG_DEMO", "ok") != 0 {
        return 2
    }
    v, err := env.Get("PICLANG_DEMO")
    if err != 0 {
        return 3
    }
    defer runtime.Free(v)
    if __strlen(v) != 2 {
        return 4
    }
    if env.Unset("PICLANG_DEMO") != 0 {
        return 5
    }
    return 0
}
