// Package mathx - small exported helpers for the pkgdemo.
package mathx

// Add is exported (capital A) and callable as mathx.Add from importers.
fn Add(a: u64, b: u64) -> u64 {
    return a + b
}

// Mul is exported.
fn Mul(a: u64, b: u64) -> u64 {
    return a * b
}

// secret is not exported (lowercase) - other packages cannot call it.
fn secret(x: u64) -> u64 {
    return x ^ 0x5A
}

// Exported string helper using PIC strings.
fn Greeting() -> *u8 {
    return "hello from mathx"
}
