// net_tcp - IPv4 TCP client demo (echo against local server if present).
//
//   # terminal A:
//   python3 -c "import socket;s=socket.socket();s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1);s.bind(('127.0.0.1',19876));s.listen(1)
//   c,_=s.accept();d=c.recv(99);c.sendall(d);c.close()"
//   # terminal B:
//   picc examples/net_tcp/main.pic -o net.bin && ./harness/run_shellcode net.bin
//
// Returns 0 on success. Also exercises ParseIP/Resolve without a server for early checks.
package main

import "std/runtime"
import "std/net"

fn main(stack_hint: *void) -> u64 {
    if !runtime.Init(stack_hint) {
        return 1
    }
    if net.Init() != 0 {
        return 2
    }

    ip, err := net.ParseIP("10.0.0.1")
    if err != 0 {
        return 3
    }
    if ip != 0x0A000001 {
        return 4
    }
    s, err2 := net.IPToString(ip)
    if err2 != 0 {
        return 5
    }
    runtime.Free(s)

    // Optional live echo on 127.0.0.1:19876
    c, err3 := net.Dial("127.0.0.1", 19876)
    if err3 != 0 {
        // server not running - still success for offline smoke of parse/init
        return 0
    }
    var msg: *u8 = "hello"
    if net.WriteAll(c, msg, 5) != 0 {
        net.Close(c)
        return 10
    }
    var buf: [16]u8
    var n: u64
    var e: *u8
    n, e = net.Read(c, &buf[0], 16)
    net.Close(c)
    if e != 0 {
        return 11
    }
    if n != 5 {
        return 12
    }
    return 0
}
