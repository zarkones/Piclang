// Package c2 - RC4 + Base64 seal/open for C2 bodies.
package c2

import "std/runtime"
import "std/crypto"
import "std/mem"

// Seal encrypts plain[0:n] with RC4(key) then Base64-encodes.
// Returns heap C string. Caller runtime.Free.
fn Seal(plain: *u8, n: u64, key: *u8, keyLen: u64) -> (*u8, *u8) {
    if n == 0 {
        return crypto.Base64Encode(cast[*u8](null), 0)
    }
    if plain == null {
        return null, "c2: null plain"
    }
    if key == null || keyLen == 0 {
        return null, "c2: null key"
    }
    var raw: *void
    var err: *u8
    raw, err = runtime.Alloc(n)
    if err != 0 {
        return null, err
    }
    var buf: *u8 = cast[*u8](raw)
    mem.Copy(cast[*void](buf), cast[*void](plain), n)
    var st: crypto.RC4
    crypto.RC4Init(&st, key, keyLen)
    crypto.RC4XOR(&st, buf, n)
    b64, err2 := crypto.Base64Encode(buf, n)
    runtime.Free(raw)
    return b64, err2
}

// Open Base64-decodes s then RC4-decrypts with key.
// Returns heap plaintext bytes + length (also NUL-terminated for convenience).
// Caller runtime.Free.
fn Open(b64: *u8, key: *u8, keyLen: u64) -> (*u8, u64, *u8) {
    if b64 == null {
        return null, 0, "c2: null body"
    }
    if key == null || keyLen == 0 {
        return null, 0, "c2: null key"
    }
    plain, n, err := crypto.Base64Decode(b64)
    if err != 0 {
        return null, 0, err
    }
    if n == 0 {
        return plain, 0, 0
    }
    var st: crypto.RC4
    crypto.RC4Init(&st, key, keyLen)
    crypto.RC4XOR(&st, plain, n)
    // ensure trailing NUL for shell APIs (extra byte already from Base64Decode)
    *(plain + n) = 0
    return plain, n, 0
}
