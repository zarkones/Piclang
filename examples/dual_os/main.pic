// dualOs - one PIC blob for Linux and Windows.
//
// Uses std/runtime (detect OS + heap) and std/strings (allocating string ops).
// Fallible APIs return (value, *u8); err == 0 means success.
//
// Build (from piclang repo root so std/ is found):
//   picc examples/dualOs/main.pic -o dualOs.bin -rand-sections=false -S
//
// Linux test:
//   ./harness/runShellcode dualOs.bin
//   # returns 0 on success
//
// Windows: map RWX + call entry (stackHint still passed; PEB path ignores it).
package main

import "std/runtime"
import "std/strings"

fn main(stackHint: *void) -> u64 {
    if !runtime.Init(stackHint) {
        return 0x100
    }

    var a: *u8 = "Hello"
    var b: *u8 = ", Piclang"
    c, err := strings.Append(a, b)
    if err != 0 {
        return 0x200
    }
    defer runtime.Free(c)

    if !strings.HasPrefix(c, "Hello") {
        return 0x201
    }
    if !strings.Contains(c, "Piclang") {
        return 0x202
    }
    if !strings.Compare(c, "Hello, Piclang") {
        return 0x203
    }

    d, err2 := strings.ReplaceAll(c, "Piclang", "World")
    if err2 != 0 {
        return 0x300
    }
    defer runtime.Free(d)
    if !strings.Compare(d, "Hello, World") {
        return 0x301
    }

    // Encode OS in success code for smoke tests: 0 = linux, 1 = windows
    if runtime.IsWindows() {
        return 1
    }
    return 0
}
