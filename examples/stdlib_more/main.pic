// stdlib_more - smoke test for time, env, path, crypto.
//
//   picc examples/stdlib_more/main.pic -o more.bin -rand-sections=false
//   ./harness/run_shellcode more.bin   # returns 0
package main

import "std/runtime"
import "std/time"
import "std/env"
import "std/path"
import "std/crypto"

fn main(stack_hint: *void) -> u64 {
    if !runtime.Init(stack_hint) {
        return 1
    }

    // --- crypto ---
    var buf: [8]u8
    var i: u64 = 0
    while i < 8 {
        buf[i] = cast[u8](i)
        i = i + 1
    }
    var key: *u8 = "secret"
    crypto.XORBytes(&buf[0], 8, key, 6)
    crypto.XORBytes(&buf[0], 8, key, 6)
    if buf[3] != 3 {
        return 10
    }
    var st: crypto.RC4
    crypto.RC4Init(&st, key, 6)
    var msg: [4]u8
    msg[0] = 1
    msg[1] = 2
    msg[2] = 3
    msg[3] = 4
    crypto.RC4XOR(&st, &msg[0], 4)
    var st2: crypto.RC4
    crypto.RC4Init(&st2, key, 6)
    crypto.RC4XOR(&st2, &msg[0], 4)
    if msg[0] != 1 {
        return 11
    }
    hx, err := crypto.HexEncode(&msg[0], 2)
    if err != 0 {
        return 12
    }
    runtime.Free(hx)

    // --- path ---
    j, err2 := path.Join("/var", "log")
    if err2 != 0 {
        return 20
    }
    b, err3 := path.Base(j)
    if err3 != 0 {
        runtime.Free(j)
        return 21
    }
    if __strlen(b) != 3 {
        runtime.Free(j)
        runtime.Free(b)
        return 22
    }
    runtime.Free(b)
    runtime.Free(j)
    if !path.IsAbs("/etc/hosts") {
        return 23
    }

    // --- time ---
    t0, err4 := time.Mono()
    if err4 != 0 {
        return 30
    }
    if time.Sleep(15 * time.Millisecond) != 0 {
        return 31
    }
    if time.Since(t0) < 5 * time.Millisecond {
        return 32
    }
    now, err5 := time.Now()
    if err5 != 0 {
        return 33
    }
    if now < 1600000000 * time.Second {
        return 34
    }

    // --- env ---
    if env.Set("PICLANG_STDLIB_MORE", "ok") != 0 {
        return 40
    }
    v, err6 := env.Get("PICLANG_STDLIB_MORE")
    if err6 != 0 {
        return 41
    }
    if __strlen(v) != 2 {
        runtime.Free(v)
        return 42
    }
    runtime.Free(v)
    env.Unset("PICLANG_STDLIB_MORE")

    return 0
}
