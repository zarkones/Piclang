// netHttp - GET DuckDuckGo and save the response body to a file.
//
//   picc examples/netHttp/main.pic -o http.bin -S
//   ./harness/runShellcode http.bin
//   # writes: /tmp/piclangDuckduckgo.html
//
// std/net speaks cleartext HTTP only (no TLS). DuckDuckGo answers http://
// with a 301 HTML body pointing at https:// - that body is what gets saved.
//
// Returns:
//   0  - wrote file
//   1  - runtime.Init failed
//   2  - net.Init failed
//   3  - HTTP request failed
//   4  - empty body
//   5  - file write failed
package main

import "std/runtime"
import "std/net"
import "std/file"

fn main(stackHint: *void) -> u64 {
    if !runtime.Init(stackHint) {
        return 1
    }
    if net.Init() != 0 {
        return 2
    }

    var url: *u8 = "http://duckduckgo.com/"
    var outPath: *u8 = "piclang_duckduckgo.html"

    var resp: net.Response
    err := net.Get(url, &resp)
    if err != 0 {
        return 3
    }
    defer net.FreeResponse(&resp)
    
    if resp.body == null {
        return 4
    }
    if resp.bodyLen == 0 {
        return 4
    }

    var werr: *u8 = file.WriteAll(outPath, resp.body, resp.bodyLen)
    if werr != 0 {
        return 5
    }
    return 0
}
