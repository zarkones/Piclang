// net_http - GET DuckDuckGo and save the response body to a file.
//
//   picc examples/net_http/main.pic -o http.bin -S
//   ./harness/run_shellcode http.bin
//   # writes: /tmp/piclang_duckduckgo.html
//
// std/net speaks cleartext HTTP only (no TLS). DuckDuckGo answers http://
// with a 301 HTML body pointing at https:// - that body is what gets saved.
//
// Returns:
//   0  - wrote file
//   1  - runtime.Init failed
//   2  - net.Init failed
//   3  - HTTP request failed
//   4  - empty body
//   5  - file write failed
package main

import "std/runtime"
import "std/net"
import "std/file"

fn main(stack_hint: *void) -> u64 {
    if !runtime.Init(stack_hint) {
        return 1
    }
    if net.Init() != 0 {
        return 2
    }

    var url: *u8 = "http://duckduckgo.com/"
    var out_path: *u8 = "piclang_duckduckgo.html"

    var resp: net.Response
    err := net.Get(url, &resp)
    if err != 0 {
        return 3
    }
    defer net.FreeResponse(&resp)
    
    if resp.body == null {
        return 4
    }
    if resp.body_len == 0 {
        return 4
    }

    var werr: *u8 = file.WriteAll(out_path, resp.body, resp.body_len)
    if werr != 0 {
        return 5
    }
    return 0
}
